# Database (Neon - free tier)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Email magic link (use Resend, free tier 3k emails/mo)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_xxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 (file uploads)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="notion-personal"
R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"

# DeepSeek AI (meeting notes extraction)
DEEPSEEK_API_KEY="sk-..."

# Mood board image providers — at least one is needed for the feature to work.
# The search route round-robins across whichever providers are configured.
#
# Unsplash: free demo tier 50 req/hr, 5k/hr after approval. Get at https://unsplash.com/developers.
UNSPLASH_ACCESS_KEY=""
# Pexels: free, 200 req/hr immediately, no approval. Get at https://www.pexels.com/api.
PEXELS_API_KEY=""
# Europeana: 50M+ cultural items, free key, instant signup. Get at https://pro.europeana.eu/get-api
EUROPEANA_API_KEY=""
# OpenVerse needs no key (Wikimedia/Flickr/museum aggregator, ~700M images).

# Owner email — features with usage limits (mood board search, YouTube import)
# are gated to this account until rate caps are configured for everyone.
# Lowercased; compared case-insensitively against the signed-in user's email.
OWNER_EMAIL=""
