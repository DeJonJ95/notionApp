# Database (Neon - free tier)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Email magic link (use Resend, free tier 3k emails/mo)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_xxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 (file uploads)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="notion-personal"
R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"

# DeepSeek AI (meeting notes extraction)
DEEPSEEK_API_KEY="sk-..."

# Gemini AI (shop-the-look image analysis)
# Get a free API key at https://aistudio.google.com/app/apikey
# Gemini 1.5 Flash: 1,500 req/day free, 60 req/min free tier.
GEMINI_API_KEY="..."

# Audio transcription for voice capture — set either one (Groq is free).
# Groq: https://console.groq.com  (whisper-large-v3-turbo)
GROQ_API_KEY=""
# OpenAI Whisper fallback (whisper-1, $0.006/min)
OPENAI_API_KEY=""

# Video transcript providers (YouTube/TikTok import)
SUPADATA_API_KEY=""

# Per-user daily AI spend cap in USD (DeepSeek + Whisper). Requests that
# would exceed it return 429 until midnight UTC. Defaults to 1.50 if unset.
DAILY_AI_COST_USD="1.50"

# Mood board image providers — at least one is needed for the feature to work.
# The search route round-robins across whichever providers are configured.
#
# Unsplash: free demo tier 50 req/hr, 5k/hr after approval. Get at https://unsplash.com/developers.
UNSPLASH_ACCESS_KEY=""
# Pexels: free, 200 req/hr immediately, no approval. Get at https://www.pexels.com/api.
PEXELS_API_KEY=""
# Europeana: 50M+ cultural items, free key, instant signup. Get at https://pro.europeana.eu/get-api
EUROPEANA_API_KEY=""
# Tumblr: free consumer key, no OAuth needed for tagged-post reads.
# Register an app at https://www.tumblr.com/oauth/apps — paste the "OAuth Consumer Key".
TUMBLR_API_KEY=""
# Google Programmable Search (Custom Search Engine): 100 queries/day free,
# then $5/1000. Used for niche fashion/aesthetic queries where Pinterest
# would be the best source — Google CSE indexes Pinterest itself.
# Setup:
# 1. Create a CSE at https://programmablesearchengine.google.com/
#    (toggle "Search the entire web" on; image search enabled).
# 2. Copy the Search Engine ID into GOOGLE_CSE_ENGINE_ID.
# 3. Enable "Custom Search API" at https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#    and generate an API key → GOOGLE_CSE_API_KEY.
# Hotlinks results (does NOT copy to R2) to stay legally clean with arbitrary
# third-party image hosts.
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_ENGINE_ID=""
# OpenVerse needs no key (Wikimedia/Flickr/museum aggregator, ~700M images).

# Owner email — features with usage limits (mood board search, YouTube import)
# are gated to this account until rate caps are configured for everyone.
# Lowercased; compared case-insensitively against the signed-in user's email.
OWNER_EMAIL=""
